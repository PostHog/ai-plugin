{
  "description": "Cursor permission gating for write commands via the PostHog MCP exec tool",
  "hooks": {
    "beforeMCPExecution": [
      {
        "command": "./hooks/cursor-gate-exec-write.sh",
        "matcher": "MCP:exec",
        "timeout": 5,
        "failClosed": false
      }
    ]
  }
}
